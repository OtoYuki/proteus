/*
 * Run every process on a Proteus GA4GH TES server through Nextflow's nf-ga4gh plugin.
 *
 *   proteus serve --port 8080 --allow-image 'ghcr.io/otoyuki/*' --allow-dir "$PWD/work"   # terminal 1
 *   nextflow run examples/nextflow/screening.nf                                            # terminal 2
 *
 * The daemon needs `--allow-dir` for Nextflow's work directory (`-w`, default ./work): the plugin
 * hands the server file:// URLs under it for every input and output.
 */

plugins {
    id 'nf-ga4gh@1.5.0'
}

process {
    executor      = 'tes'
    errorStrategy = 'retry'
    maxRetries    = 1
    cpus          = 1
    memory        = '1 GB'
}

tes {
    // Base URL only: the plugin appends /v1/tasks itself.
    endpoint = System.getenv('PROTEUS_TES_ENDPOINT') ?: 'http://127.0.0.1:8080'
    // With `proteus serve --auth-token …`: sent as `Authorization: Bearer`.
    oauthToken = System.getenv('PROTEUS_AUTH_TOKEN') ?: null
}
