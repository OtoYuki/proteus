// Runs locally with `proteus` on PATH; add `-with-docker` / `-with-podman` to use the module's
// container, or `-with-conda` for the Bioconda package once it is published.
params {
    campaigns = null
    interface = 'A'
    outdir    = 'results'
}

process {
    withName: 'PROTEUS_ANALYZE' {
        cpus      = 4
        ext.args  = { "--interface ${params.interface}" }
        publishDir = [path: { params.outdir }, mode: 'copy']
    }
}
