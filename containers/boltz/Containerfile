# Boltz-2 for the `sota` tier, with its weights baked in so a job never downloads at run time.
#
#   podman build -t ghcr.io/jwohlwend/boltz:latest containers/boltz
#
# The GPU is handed in by the OCI runner (CDI `nvidia.com/gpu=all`); the host needs the
# NVIDIA Container Toolkit's CDI spec (`nvidia-ctk cdi generate`). Without one it runs on CPU.
FROM docker.io/library/python:3.11-slim-bookworm

ARG BOLTZ_VERSION=2.2.1
ENV BOLTZ_CACHE=/opt/boltz \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN pip install "boltz[cuda]==${BOLTZ_VERSION}"

# `boltz predict` calls download_boltz2 on every run and fetches whatever is missing: the CCD
# (mols.tar and its extraction), the structure checkpoint and the affinity checkpoint.
RUN mkdir -p /opt/boltz && python -c "from pathlib import Path; from boltz.main import download_boltz2; download_boltz2(Path('/opt/boltz'))"

WORKDIR /workspace
